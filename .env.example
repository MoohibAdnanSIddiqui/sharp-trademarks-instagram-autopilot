# ---------------------------------------------------------------------------
# Sharp Trademarks — Instagram Autopilot
# Copy to .env for local use. NEVER commit .env. In CI these become GitHub Secrets.
# Every value below is a PLACEHOLDER. Do not paste real credentials into a chat.
# ---------------------------------------------------------------------------

# --- Google Gemini -------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Instagram Graph API -------------------------------------------------
# Numeric Instagram professional account ID (NOT the @handle).
IG_USER_ID=17841400000000000
# Long-lived access token (~60 days). Refreshed automatically by the
# refresh-token workflow; store the newest value as a GitHub Secret.
IG_ACCESS_TOKEN=your-long-lived-access-token
# Meta app credentials — needed only to refresh the long-lived token.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# graph.facebook.com (Facebook Login) | graph.instagram.com (Instagram Login)
IG_API_HOST=graph.facebook.com
IG_API_VERSION=v23.0

# --- Media hosting -------------------------------------------------------
# Only needed when media_host.provider = github_raw and the workflow pushes
# assets. In GitHub Actions the built-in GITHUB_TOKEN covers this.
GITHUB_TOKEN=
# Only needed when media_host.provider = s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Runtime switches (override config/settings.yaml) --------------------
DRY_RUN=true
AUTO_PUBLISH=false
POSTS_PER_DAY=2
POST_INTERVAL_HOURS=12
TIMEZONE=America/New_York
LOG_LEVEL=INFO
